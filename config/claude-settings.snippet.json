{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "__AGENT_BRIDGE_DIR__/hooks/ask_options.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          { "type": "command", "command": "__AGENT_BRIDGE_DIR__/hooks/notify.sh input" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__AGENT_BRIDGE_DIR__/hooks/notify.sh done" }
        ]
      }
    ]
  }
}
